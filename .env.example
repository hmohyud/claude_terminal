# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Password that gates the terminal (required). Change it to anything you like;
# changing it logs every browser out.
TERMINAL_PASSWORD=change-me

# Secret used to sign the login cookie. If blank, one is generated on first
# start and kept in data/session-secret.
SESSION_SECRET=

# How many days a login cookie stays valid
SESSION_DAYS=30

# Network binding. 127.0.0.1 = this machine only. 0.0.0.0 = reachable on your LAN.
HOST=127.0.0.1
PORT=3123

# Set to 1 when serving over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=0

# Storage caps. Oldest threads/files are removed first when a cap is reached.
MAX_THREADS=200
MAX_FILES=300
MAX_FILES_MB=1024

# Optional starting monthly budget in USD (can also be set in the app)
MONTHLY_BUDGET_USD=
